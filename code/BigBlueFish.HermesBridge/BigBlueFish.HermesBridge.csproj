<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only: WPF imaging (WIC) shrinks images that do not fit Hermes' request limit. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>BigBlueFish.HermesBridge</AssemblyName>
    <!-- Run as dotnet BigBlueFish.HermesBridge.dll (run-hermes-bridge.ps1): Windows Defender's machine-learning scan took the
         unsigned apphost.exe a build patches for this console app for a trojan (Trojan:Win32/Bearfoos.B!ml, 2026-10-28). -->
    <UseAppHost>false</UseAppHost></PropertyGroup>
  <!-- WPF projects leave System.IO and System.Net.Http out of the implicit usings. -->
  <ItemGroup><Using Include="System.IO" /><Using Include="System.Net.Http" /></ItemGroup>
</Project>
